# Copy to scripts/appstore.env and fill in. That file is git-ignored.

# Apple Developer Team ID (developer.apple.com → Membership → Team ID)
TEAM_ID=XXXXXXXXXX

# App Store Connect API key (App Store Connect → Users and Access → Integrations → App Store Connect API).
# Role: App Manager (or Admin). If left empty, the script uses the Apple ID signed in to Xcode.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Version shown in the store; build number defaults to a timestamp (must increase for every upload).
MARKETING_VERSION=1.0.0
# BUILD_NUMBER=42
